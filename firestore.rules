rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
      );
    }

    function isSenior() {
      return hasRole('senior') || hasRole('teacher') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // 1. Users Collection
    match /users/{userId} {
      // Anyone authenticated can read basic profile; unauthenticated can read lender rating
      allow read: if true;
      // User can create their own profile upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // User can update non-privileged fields; cannot tamper with role, trust metrics, or lending counters
      allow update: if (isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'trustScore', 'trustTier', 'totalBorrowed', 'totalLent'])) ||
                    isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Equipment Collection
    match /equipment/{equipmentId} {
      // Anyone can read catalog inventory
      allow read: if true;
      // Only authenticated students/seniors can list equipment
      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.title.size() > 2;
      // Owner or Admin can update equipment details; cannot forge ownerId
      allow update: if (isOwner(resource.data.ownerId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])) || 
                    isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // 3. Borrow Requests Collection
    match /borrowRequests/{orderId} {
      // Borrower, assigned Lender, or Admin can read the order
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.borrowerId ||
        request.auth.uid == resource.data.lenderId ||
        isAdmin()
      );
      // Authenticated borrower can create request with valid status 'pending'
      allow create: if isAuthenticated() && 
                    request.resource.data.borrowerId == request.auth.uid &&
                    request.resource.data.borrowerId != request.resource.data.lenderId &&
                    request.resource.data.status == 'pending';
      // Lender or Admin can approve/decline/return; Borrower can only cancel pending (never self-approve)
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.borrowerId && request.resource.data.status in ['cancelled'] && resource.data.status == 'pending') ||
        (request.auth.uid == resource.data.lenderId && request.auth.uid != resource.data.borrowerId && request.resource.data.status in ['approved', 'declined', 'returned']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 4. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.reviewerId == request.auth.uid &&
                    request.resource.data.rating >= 1 && 
                    request.resource.data.rating <= 5;
      allow update: if isOwner(resource.data.reviewerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Notifications Collection
    match /notifications/{notificationId} {
      // Users can only view and update their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // System server functions or authorized seniors create notifications
      allow create: if isSenior() || isAdmin();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
