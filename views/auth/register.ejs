<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container container-compact">
    <%- include('../partials/flash') %>

    <div class="card" style="padding: var(--space-8); box-shadow: var(--shadow-card);">
      <div style="text-align: center; margin-bottom: var(--space-6);">
        <div class="brand-icon" style="margin: 0 auto var(--space-3); width: 44px; height: 44px; font-size: 22px;" aria-hidden="true">⚡</div>
        <h1 style="font-size: 22px;">Create your account</h1>
        <p class="caption">Join CampusEquip to borrow and lend institutional engineering equipment</p>
      </div>

      <form action="/auth/register" method="POST" id="registerForm" novalidate>
        <div id="registerClientAlert" style="display: none; margin-bottom: var(--space-4);" class="alert alert-error"></div>

        <div class="form-group">
          <label class="form-label form-label-required" for="name">Full Name</label>
          <input 
            type="text" 
            name="name" 
            id="name" 
            class="form-control" 
            placeholder="e.g. Aranya Sen" 
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" 
            required 
            autocomplete="name"
          >
        </div>

        <div class="form-group">
          <label class="form-label form-label-required" for="email">Campus Email</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="form-control" 
            placeholder="your.name@campus.edu" 
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
            required 
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label class="form-label form-label-required" for="password">Password</label>
          <div style="position: relative;">
            <input 
              type="password" 
              name="password" 
              id="password" 
              class="form-control" 
              placeholder="Minimum 6 characters" 
              required 
              autocomplete="new-password"
              style="padding-right: 42px;"
            >
            <button 
              type="button" 
              class="no-spin" 
              onclick="togglePasswordVisibility('password', this)" 
              aria-label="Toggle password visibility" 
              style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-muted); font-size: 15px; padding: 4px;"
            >
              👁️
            </button>
          </div>
          <div id="pwdLengthHint" style="font-size: 11px; color: var(--color-muted); margin-top: 4px;">Must be at least 6 characters</div>
        </div>

        <div class="form-group">
          <label class="form-label form-label-required" for="confirmPassword">Confirm Password</label>
          <div style="position: relative;">
            <input 
              type="password" 
              name="confirmPassword" 
              id="confirmPassword" 
              class="form-control" 
              placeholder="Re-enter your password" 
              required 
              autocomplete="new-password"
              style="padding-right: 42px;"
            >
            <button 
              type="button" 
              class="no-spin" 
              onclick="togglePasswordVisibility('confirmPassword', this)" 
              aria-label="Toggle password visibility" 
              style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-muted); font-size: 15px; padding: 4px;"
            >
              👁️
            </button>
          </div>
          <div id="pwdMatchHint" style="font-size: 11px; margin-top: 4px; display: none;"></div>
        </div>

        <div style="margin: var(--space-4) 0 var(--space-3); padding-top: var(--space-3); border-top: 1px dashed var(--color-border);">
          <span style="font-size: 11px; font-weight: 600; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.5px;">Institutional Details</span>
        </div>

        <div class="form-group">
          <label class="form-label form-label-required" for="collegeId">College Roll / ID Number</label>
          <input 
            type="text" 
            name="collegeId" 
            id="collegeId" 
            class="form-control" 
            placeholder="e.g. ME-2024-042" 
            value="<%= typeof formData !== 'undefined' && formData.collegeId ? formData.collegeId : '' %>" 
            required
          >
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label form-label-required" for="department">Department</label>
            <select name="department" id="department" class="form-control" required>
              <option value="Mechanical" <%= typeof formData !== 'undefined' && formData.department === 'Mechanical' ? 'selected' : '' %>>Mechanical</option>
              <option value="Civil" <%= typeof formData !== 'undefined' && formData.department === 'Civil' ? 'selected' : '' %>>Civil</option>
              <option value="Electrical" <%= typeof formData !== 'undefined' && formData.department === 'Electrical' ? 'selected' : '' %>>Electrical</option>
              <option value="Survey" <%= typeof formData !== 'undefined' && formData.department === 'Survey' ? 'selected' : '' %>>Survey</option>
              <option value="Electronics / Lab" <%= typeof formData !== 'undefined' && formData.department === 'Electronics / Lab' ? 'selected' : '' %>>Electronics / Lab</option>
              <option value="Other Engineering" <%= typeof formData !== 'undefined' && formData.department === 'Other Engineering' ? 'selected' : '' %>>Other Engineering</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label form-label-required" for="role">Account Type</label>
            <select name="role" id="role" class="form-control">
              <option value="student" <%= typeof formData !== 'undefined' && formData.role === 'student' ? 'selected' : '' %>>Student (Borrower)</option>
              <option value="senior" <%= typeof formData !== 'undefined' && formData.role === 'senior' ? 'selected' : '' %>>Senior (Lender)</option>
            </select>
          </div>
        </div>

        <button type="submit" id="registerSubmitBtn" class="btn btn-primary btn-full btn-lg" style="margin-top: var(--space-4);">
          Create Account
        </button>

        <!-- Quick Demo Fill -->
        <div style="margin-top: var(--space-3); text-align: center;">
          <button type="button" class="btn btn-ghost btn-sm no-spin" onclick="fillSampleStudent()" style="font-size: 11px; color: var(--color-muted);">
            ⚡ Fill Sample Student Data
          </button>
        </div>
      </form>

      <!-- OR Divider -->
      <div class="auth-divider" role="separator" aria-label="Social registration options">
        <span>OR SIGN UP WITH</span>
      </div>

      <!-- Social Registration Buttons -->
      <div id="socialButtonsContainer">
        <button type="button" class="btn btn-social btn-google" data-social-provider="google" aria-label="Sign up with Google">
          <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          Continue with Google
        </button>

        <button type="button" class="btn btn-social btn-github" data-social-provider="github" aria-label="Sign up with GitHub">
          <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          Continue with GitHub
        </button>

        <button type="button" class="btn btn-social btn-facebook" data-social-provider="facebook" aria-label="Sign up with Facebook">
          <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" fill="#1877F2" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Continue with Facebook
        </button>

        <button type="button" class="btn btn-social btn-linkedin" data-social-provider="linkedin" aria-label="Sign up with LinkedIn">
          <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          Continue with LinkedIn
        </button>
      </div>

      <div style="margin-top: var(--space-6); text-align: center; border-top: 1px solid var(--color-border); padding-top: var(--space-4); font-size: 13px;">
        <span class="text-muted">Already registered?</span> 
        <a href="/auth/login" style="font-weight: 600; margin-left: 4px;">Sign In</a>
      </div>
    </div>

  </div>
</main>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🔒';
      btn.setAttribute('aria-label', 'Hide password');
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
      btn.setAttribute('aria-label', 'Show password');
    }
  }

  function fillSampleStudent() {
    const r = Math.floor(100 + Math.random() * 900);
    document.getElementById('name').value = 'Ananya Roy';
    document.getElementById('email').value = 'ananya.' + r + '@campus.edu';
    document.getElementById('password').value = 'password123';
    document.getElementById('confirmPassword').value = 'password123';
    document.getElementById('collegeId').value = 'ME-2024-' + r;
    document.getElementById('department').value = 'Mechanical';
    checkPasswordMatch();
  }

  function checkPasswordMatch() {
    const pwd = document.getElementById('password').value;
    const cpwd = document.getElementById('confirmPassword').value;
    const hint = document.getElementById('pwdMatchHint');

    if (!cpwd) {
      hint.style.display = 'none';
      return true;
    }

    hint.style.display = 'block';
    if (pwd === cpwd) {
      hint.style.color = 'var(--color-success)';
      hint.textContent = '✓ Passwords match';
      return true;
    } else {
      hint.style.color = 'var(--color-danger)';
      hint.textContent = '⚠️ Passwords do not match';
      return false;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const pwd = document.getElementById('password');
    const cpwd = document.getElementById('confirmPassword');
    const form = document.getElementById('registerForm');
    const alertBox = document.getElementById('registerClientAlert');

    if (pwd) pwd.addEventListener('input', checkPasswordMatch);
    if (cpwd) cpwd.addEventListener('input', checkPasswordMatch);

    if (form) {
      form.addEventListener('submit', (e) => {
        const nameVal = document.getElementById('name').value.trim();
        const emailVal = document.getElementById('email').value.trim();
        const pwdVal = pwd.value;
        const cpwdVal = cpwd.value;

        if (!nameVal || !emailVal || !pwdVal) {
          e.preventDefault();
          alertBox.style.display = 'block';
          alertBox.textContent = 'Please fill out all required fields.';
          return;
        }

        if (pwdVal.length < 6) {
          e.preventDefault();
          alertBox.style.display = 'block';
          alertBox.textContent = 'Password must be at least 6 characters long.';
          pwd.focus();
          return;
        }

        if (pwdVal !== cpwdVal) {
          e.preventDefault();
          alertBox.style.display = 'block';
          alertBox.textContent = 'Passwords do not match. Please re-enter.';
          cpwd.focus();
          return;
        }

        alertBox.style.display = 'none';
      });
    }
  });
</script>
<script src="/js/socialAuth.js"></script>
<%- include('../partials/footer') %>
