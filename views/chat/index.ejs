<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('../partials/flash') %>

    <!-- Breadcrumb Wayfinding -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb-item">Home</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current" aria-current="page">AI Hardware Assistant</span>
    </nav>

    <div style="margin-bottom: var(--space-6);">
      <h1>Campus Hardware & Lending Assistant</h1>
      <p class="text-muted">Instant answers for station pickups, Sunday policies, deposit rules, and recommended lab tools.</p>
    </div>

    <!-- 2-Column AI Assistant Layout (Matching Reference 4) -->
    <div class="chat-layout-grid">
      
      <!-- Left Column: Interactive Chat Card -->
      <div class="chat-container">
        
        <!-- Chat Header with Purple Bot Avatar & Status Dot -->
        <div class="chat-header">
          <div class="chat-bot-avatar" aria-hidden="true">
            🤖
            <span class="chat-status-dot"></span>
          </div>
          <div>
            <div class="font-semibold" style="font-size: 15px;">Campus Hardware Guide AI</div>
            <div class="caption" style="color: var(--color-success); font-weight: 500;">● Online • Instant Campus Knowledge</div>
          </div>
        </div>

        <!-- Messages Body -->
        <div id="chatMessagesContainer" class="chat-messages" role="log" aria-live="polite" aria-label="Chat conversation history">
          
          <!-- Welcome Message -->
          <div class="chat-message-bubble bot-msg">
            Hello! I am your Campus Lending Assistant. Ask me anything about equipment locations, deposit refund procedures, or borrowing rules.
          </div>

          <!-- Quick Prompt Chips -->
          <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-2);" role="toolbar" aria-label="Suggested questions">
            <button type="button" class="quick-filter-pill" onclick="document.getElementById('chatAssistantInput').value='Where can I pick up my equipment?'; document.getElementById('chatAssistantForm').dispatchEvent(new Event('submit'));">
              📍 Pickup Locations?
            </button>
            <button type="button" class="quick-filter-pill" onclick="document.getElementById('chatAssistantInput').value='How does the security deposit refund work?'; document.getElementById('chatAssistantForm').dispatchEvent(new Event('submit'));">
              💰 Deposit Refund Policy?
            </button>
            <button type="button" class="quick-filter-pill" onclick="document.getElementById('chatAssistantInput').value='Can I borrow equipment on Sunday?'; document.getElementById('chatAssistantForm').dispatchEvent(new Event('submit'));">
              📅 Sunday Closed Rules?
            </button>
            <button type="button" class="quick-filter-pill" onclick="document.getElementById('chatAssistantInput').value='How do I increase my Trust Score?'; document.getElementById('chatAssistantForm').dispatchEvent(new Event('submit'));">
              ⭐ How Trust Scores Work?
            </button>
          </div>

        </div>

        <!-- Input Bar with Purple Button -->
        <div class="chat-input-bar">
          <form id="chatAssistantForm" style="display: flex; gap: var(--space-2);">
            <input 
              type="text" 
              id="chatAssistantInput" 
              class="form-control" 
              placeholder="Type your question (e.g., 'What are the rules for total station survey gear?')..." 
              autocomplete="off" 
              required
              aria-label="Ask the Campus AI Assistant"
            >
            <button type="submit" class="btn btn-primary no-spin" style="white-space: nowrap; padding: 0 var(--space-5);">
              Send ➔
            </button>
          </form>
        </div>

      </div>

      <!-- Right Column: 3 Reference Status Cards (Matching Reference 4) -->
      <aside class="chat-side-cards" aria-label="Campus Lending Guidelines">
        
        <!-- Card 1: Coral / Rose Notice -->
        <div class="chat-side-card card-coral">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span style="font-size: 18px;" aria-hidden="true">⚠️</span>
            <strong style="color: #991B1B; font-size: 14px;">Sunday Closed Policy</strong>
          </div>
          <p class="caption" style="color: #7F1D1D; line-height: 18px;">
            Campus lending stations are closed on Sundays. Any loan due on Sunday automatically rolls over to Monday 10:00 AM with zero penalty.
          </p>
        </div>

        <!-- Card 2: Mint / Emerald Notice -->
        <div class="chat-side-card card-mint">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span style="font-size: 18px;" aria-hidden="true">🛡️</span>
            <strong style="color: #065F46; font-size: 14px;">100% Refund Guarantee</strong>
          </div>
          <p class="caption" style="color: #064E3B; line-height: 18px;">
            Your security deposit is immediately returned in full when the senior custodian inspects and confirms the returned instrument in good condition.
          </p>
        </div>

        <!-- Card 3: Sky Blue Information -->
        <div class="chat-side-card card-sky">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span style="font-size: 18px;" aria-hidden="true">📍</span>
            <strong style="color: #1E40AF; font-size: 14px;">Campus Pickup Stations</strong>
          </div>
          <p class="caption" style="color: #1E3A8A; line-height: 18px;">
            Pickup stations operate Mon–Sat, 9:00 AM to 5:00 PM at Mechanical Workshop, Survey Station (Floor 2), and Central Electronics Lab.
          </p>
        </div>

      </aside>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
